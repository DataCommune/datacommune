# Frontend app env template — copy to .env for local builds when needed
VITE_API_URL=http://127.0.0.1:8000

# Public app key for anonymous requests from the SvelteKit app and marketing pages.
# This key is intentionally public and must stay quota-capped server-side.
PUBLIC_DC_API_KEY=dc_anon_xxxxxxxxxxxxx

# Audience measurement with the self-hosted GoatCounter of the public stack (04.7-14b).
# Optional: unset or anything but true = no count. Only the public build sets it to true.
VITE_MESURE_AUDIENCE=

# Google Search Console HTML-tag verification token (the content= value only).
# Optional, and only needed if the DNS TXT verification method is not used.
VITE_GOOGLE_SITE_VERIFICATION=

# Weekly allowance of distinct address fiches per anonymous session (H-3), read by the
# Node server at each request (src/lib/server/fiche-quota.ts). 100 was set by Ianis on
# 2026-10-24 (04.2-TEXTES.md) and is the code default; the CGU state the same number.
# 0 turns the quota off and must only ever be chosen on purpose. On a server, a new
# value reaches the container only after `up -d --no-deps --force-recreate`, not `restart`.
FICHE_QUOTA_WEEKLY=100
