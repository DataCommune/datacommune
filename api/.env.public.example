# Public instance (api/docker-compose.public.yml) -- variable NAMES with dummy values.
# The real file lives ONLY in the CT: /opt/datacommune/.env (mode 600, root).
# It is created by provision-workbase.sh (private hypervisor script), which generates the secrets inside
# the CT; the two values marked MANUAL are appended by hand in the CT. Never commit it.

# --- PostgreSQL (generated in the CT) ---
POSTGRES_DB=datacommune
POSTGRES_USER=datacommune
POSTGRES_PASSWORD=dummy-generated-in-the-ct

# --- API secrets (generated in the CT) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dummy-generated-in-the-ct
JWT_SECRET_KEY=dummy-generated-in-the-ct
API_KEY_HMAC_SECRET=dummy-generated-in-the-ct

# --- Cloudflare Tunnel (MANUAL: token of the tunnel created in the Cloudflare dashboard) ---
CF_TUNNEL_TOKEN=dummy-tunnel-token

# --- Public frontend key (MANUAL: output of api/backend/scripts/rotate_anon_key.py) ---
# Inlined in the JS bundle at image build time; must start with dc_anon_.
PUBLIC_DC_API_KEY=dc_anon_dummy

# --- Set by infra/public/public-deploy.sh for each release (not in the file) ---
# IMAGE_TAG=<first 12 characters of the commit>
# DEPLOYMENT_SHA=<full commit sha>
