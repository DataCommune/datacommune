    {"name": "dpe_document", "path": "/v1/bien/dpe/document", "params": {}, "params_from": {"contexte": {"route": "resolve", "pointer": "donnees.0.dpe_inventory.context_ref"}, "reference": {"route": "dpe_inventaire", "pointer": "items.0.document_ref"}}, "cle_attendue": "document_ref", "non_vide": false}
  ]
