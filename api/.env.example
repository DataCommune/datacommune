# =============================================================================
# DataCommune API — Environment Variables
# =============================================================================
# Copy this file to .env.prod (production) or .env.dev (development).
# NEVER commit .env.prod or .env.dev to git.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=datacommune
POSTGRES_USER=datacommune
POSTGRES_PASSWORD=devpassword            # CHANGE in production (openssl rand -base64 32)

# --- Application ---
DEBUG=true                               # false in production
LOG_FORMAT=text                          # json in production
TAG=latest                               # Docker image tag
API_BASE_URL=http://localhost:8000       # public HTTPS URL in production

# --- Database URL (auto-constructed in compose, override if needed) ---
# DATABASE_URL=postgresql+asyncpg://datacommune:devpassword@db:5432/datacommune

# --- Auth ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-password        # CHANGE in production
JWT_SECRET_KEY=dev-secret-key-not-for-production  # CHANGE in production (openssl rand -base64 64)
API_KEY_HMAC_SECRET=                     # CHANGE in production — set to current JWT_SECRET_KEY value initially, then manage independently (openssl rand -base64 64)
INTERNAL_UNLIMITED_KEY_HASH=              # Optional HMAC digest for one internal service key

# --- CORS (override default — must include localhost for dev) ---
# SEC-06: localhost is NOT in the default cors_origins — must be set explicitly.
CORS_ORIGINS=["https://datacommune.fr","https://www.datacommune.fr","https://dev.datacommune.fr","http://localhost:5173"]
# Enable only when every public request reaches the API through a trusted proxy.
TRUST_PROXY_HEADERS=false

# --- External Services (optional in dev — features degrade gracefully) ---
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=               # Stripe Price ID — Pro monthly
STRIPE_PRICE_PRO_ANNUAL=                # Stripe Price ID — Pro annual
STRIPE_PRICE_BUSINESS_MONTHLY=          # Stripe Price ID — Business monthly
STRIPE_PRICE_BUSINESS_ANNUAL=           # Stripe Price ID — Business annual
STRIPE_PRICE_ENTERPRISE_MONTHLY=        # Stripe Price ID — Enterprise monthly
STRIPE_PRICE_ENTERPRISE_ANNUAL=         # Stripe Price ID — Enterprise annual
SMOKE_TEST_API_KEY=

# --- Dev-only ---
DB_PORT=5432                             # Exposed DB port (dev overlay only)
