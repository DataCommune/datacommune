# .env — DataCommune API
# Generated by Ansible from infra/templates/env.j2 using vault_* vars.
# This file is owned root:root mode 0600. DO NOT edit manually (D-06 anti-drift).
# To update a secret: edit infra/vault.yml, commit, re-run the playbook.

# --- Database ---
POSTGRES_USER={{ postgres_user }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

# asyncpg URL for FastAPI (config.py)
DATABASE_URL=postgresql+asyncpg://{{ postgres_user }}:{{ vault_postgres_password }}@db:5432/{{ postgres_db }}

# --- Application ---
# API base URL (must NOT start with http://localhost — config.py gate)
API_BASE_URL=https://{{ api_domain }}

# JWT signing key (min 32 chars, strong random — D-11)
JWT_SECRET_KEY={{ vault_jwt_secret_key }}

# Admin endpoint password (config.py gate rejects "changeme")
ADMIN_PASSWORD={{ vault_admin_password }}
ADMIN_USERNAME=admin

# API key HMAC secret (min 32 chars — D-11)
API_KEY_HMAC_SECRET={{ vault_api_key_hmac_secret }}

# --- Cloudflare Tunnel token (D-03) ---
# Used by the cloudflared service in docker-compose.vps.yml
CF_TUNNEL_TOKEN={{ vault_cf_tunnel_token }}

# --- Stripe/Resend — BILLING DISABLED (ADR-0002 / D-13) ---
# Fake non-empty values pass the FastAPI production boot gate (config.py:149-150)
# without activating Stripe or Resend functionality.
# The real APIs reject these values silently — no billing charges possible.
STRIPE_SECRET_KEY=sk_disabled_demo
STRIPE_WEBHOOK_SECRET=stripe-disabled-demo
RESEND_API_KEY=resend-disabled-demo

# --- Runtime / Proxy ---
# Cloudflare injects real client IP via CF-Connecting-IP header
TRUST_PROXY_HEADERS=true

# CORS origins: production and development frontends
CORS_ORIGINS=["https://datacommune.fr","https://www.datacommune.fr","https://dev.datacommune.fr"]

# Smoke test API key (optional — for automated health checks via authenticated endpoint)
SMOKE_TEST_API_KEY=

# --- Hosted scope ---
# Not an environment variable: the hosted scope lives in the database and is
# set with `python -m app.scope set` (D-23).
