# Non-secret settings of the production scripts (deploy.sh, down.sh, psql.sh).
# Copy to infra/prod/prod.env and fill DEPLOYMENT_HOST once the server is rented.
# Every value can be overridden from the environment of the caller.
#
# NEVER add a secret here. The secrets live only on the server, in $PROD_DIR/.env
# (mode 600, owner datacommune), written by the private bootstrap block of README.md.

# Address of the rented server (IP or DNS name), reached over ssh with Ianis's key. Same IP
# family as provision.sh --admin-ip: ufw admits SSH from that family only, so with an IPv4
# --admin-ip give the IPv4 address, not a name that also resolves to an AAAA record.
DEPLOYMENT_HOST=
# Account created by provision.sh (docker group, owner of PROD_DIR).
DEPLOYMENT_USER=datacommune
# Releases, state, pre-deploy dumps, source archive, compose env file.
PROD_DIR=/opt/datacommune

# Hosts served by api/Caddyfile.prod, used as Host headers by the health checks of deploy.sh.
# They must match the site addresses of api/Caddyfile.prod (checked by tests/test-prod-scripts.sh).
PROD_DOMAIN=prod.datacommune.fr
PROD_API_DOMAIN=api-prod.datacommune.fr
APEX_DOMAIN=datacommune.fr
API_DOMAIN=api.datacommune.fr

# Monthly quota of the anonymous bundle key created at the first deployment
# (api/backend/scripts/rotate_anon_key.py; same default as the public instance).
ANON_KEY_QUOTA=500
