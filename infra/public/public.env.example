# Settings of the public instance (sourced by infra/public/lib.sh). Template: copy it to
# infra/public/public.local.env (git-ignored, D-140) and fill every value, or point
# PUBLIC_SETTINGS_FILE at another file. The scripts refuse to start while one is empty.
# Every value can be overridden from the environment of the caller. NEVER put a secret here:
# the secrets of the stack live only in $PUBLIC_ENV_FILE on the host (mode 600, root).
#
# The scripts run on the workstation, reach the hypervisor over ssh and the container of the
# public stack through `pct exec` (Proxmox). Values below are examples, not defaults.

# ssh name of the hypervisor (an alias of ~/.ssh/config).
: "${PUBLIC_SSH_HOST:=}"            # e.g. my-hypervisor
# Container id of the public stack, and of the work base its database is copied from.
: "${PUBLIC_CTID:=}"                # e.g. 901
: "${PUBLIC_SOURCE_CTID:=}"         # e.g. 902
# Releases, state and database backups of the public stack, inside its container.
: "${PUBLIC_DIR:=}"                 # e.g. /opt/datacommune
# Env file read by compose for interpolation (secrets, mode 600).
: "${PUBLIC_ENV_FILE:=}"            # e.g. /opt/datacommune/.env
# Compose projects of the public stack and of the work base.
: "${PUBLIC_PROJECT:=}"             # e.g. datacommune-public
: "${PUBLIC_SOURCE_PROJECT:=}"      # e.g. datacommune-workbase
# National publication by ZFS clone (public-db-restore.sh --from-zfs-clone): pool, dataset
# of the work pgdata, parent of the public clones, host directories of the pre-switch dumps
# and of the switch states, PBS storage of the container backups, memory of the public
# container once it serves the national base.
: "${PUBLIC_ZFS_POOL:=}"            # e.g. tank
: "${PUBLIC_ZFS_SOURCE:=}"          # e.g. tank/work/pg
: "${PUBLIC_ZFS_PARENT:=}"          # e.g. tank/public
: "${PUBLIC_BACKUP_HOST_DIR:=}"     # e.g. /srv/backups/datacommune
: "${PUBLIC_SWITCH_STATE_DIR:=}"    # e.g. /root/dc-public
: "${PUBLIC_PBS_STORAGE:=}"         # e.g. pbs
: "${PUBLIC_NATIONAL_MEMORY_MB:=}"  # e.g. 16384
# Optional: container ids a deploy must never target (space-separated).
: "${PUBLIC_PROTECTED_CTIDS:=}"
