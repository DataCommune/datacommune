# Settings of the doubles tests of infra/public (copied as public.local.env into their scratch
# repository). Fictitious machine: no host, container or pool of a real installation.
: "${PUBLIC_SSH_HOST:=fakehost}"
: "${PUBLIC_CTID:=903}"
: "${PUBLIC_SOURCE_CTID:=902}"
: "${PUBLIC_DIR:=/opt/datacommune-public}"
: "${PUBLIC_ENV_FILE:=/opt/datacommune/.env}"
: "${PUBLIC_PROJECT:=datacommune-public}"
: "${PUBLIC_SOURCE_PROJECT:=datacommune-work}"
: "${PUBLIC_ZFS_POOL:=dcpool}"
: "${PUBLIC_ZFS_SOURCE:=dcpool/work/pg}"
: "${PUBLIC_ZFS_PARENT:=dcpool/public}"
: "${PUBLIC_BACKUP_HOST_DIR:=/mnt/usb-8tb/datacommune-backups}"
: "${PUBLIC_SWITCH_STATE_DIR:=/root/dc-public}"
: "${PUBLIC_PBS_STORAGE:=pbs-main}"
: "${PUBLIC_NATIONAL_MEMORY_MB:=12288}"
: "${PUBLIC_PROTECTED_CTIDS:=975}"
